      "source": [
        "\n",
        "import random\n",
        "\n",
        "# Initialize parameters\n",
        "POPULATION_SIZE = 6\n",
        "GENERATIONS = 20\n",
        "MUTATION_RATE = 0.1\n",
        "\n",
        "# Generate random population\n",
        "# Each individual = [Attack, Defence, Speed]\n",
        "population = [\n",
        "    [random.randint(0, 100) for _ in range(3)]\n",
        "    for _ in range(POPULATION_SIZE)\n",
        "]\n",
        "\n",
        "# Fitness function\n",
        "def fitness(individual):\n",
        "    attack, defence, speed = individual\n",
        "    return 0.4 * attack + 0.3 * defence + 0.3 * speed\n",
        "\n",
        "# Selection\n",
        "def selection(population):\n",
        "    population.sort(key=fitness, reverse=True)\n",
        "    return population[:2]\n",
        "\n",
        "# Crossover\n",
        "def crossover(parent1, parent2):\n",
        "    child = []\n",
        "    for i in range(3):\n",
        "        child.append(random.choice([parent1[i], parent2[i]]))\n",
        "    return child\n",
        "\n",
        "# Mutation\n",
        "def mutation(child):\n",
        "    for i in range(3):\n",
        "        if random.random() < MUTATION_RATE:\n",
        "            child[i] = random.randint(0, 100)\n",
        "    return child\n",
        "\n",
        "# Genetic Algorithm\n",
        "for generation in range(GENERATIONS):\n",
        "\n",
        "    parents = selection(population)\n",
        "\n",
        "    new_population = parents.copy()\n",
        "\n",
        "    while len(new_population) < POPULATION_SIZE:\n",
        "        child = crossover(parents[0], parents[1])\n",
        "        child = mutation(child)\n",
        "        new_population.append(child)\n",
        "\n",
        "    population = new_population\n",
        "\n",
        "# Find best AI opponent\n",
        "best = max(population, key=fitness)\n",
        "\n",
        "# Display result\n",
        "print(\"Best AI Opponent Behaviour\")\n",
        "print(\"Attack:\", best[0])\n",
        "print(\"Defence:\", best[1])\n",
        "print(\"Speed:\", best[2])\n",
        "print(\"Fitness Score:\", fitness(best))\n"
      ],
